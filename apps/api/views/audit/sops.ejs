<%- include('../partials/head', { title }) %>
<%- include('../partials/internal-topbar', { user, active }) %>

<main class="container audit-main">
  <%- include('../partials/flash', { ok, err }) %>

  <div class="pagehead">
    <div>
      <h1>Pustaka SOP</h1>
      <div class="sub">Dokumen prosedur operasional standar sebagai acuan pemeriksaan audit.</div>
    </div>
  </div>

  <div class="table-wrap">
    <table>
      <thead><tr><th>Kode</th><th>Judul</th><th>Versi</th><th class="right">Dokumen</th></tr></thead>
      <tbody>
        <% sops.forEach(function (s) { %>
          <tr>
            <td class="mono nowrap"><%= s.code %></td>
            <td>
              <strong><%= s.title %></strong>
              <% if (s.description) { %><div class="small muted"><%= s.description %></div><% } %>
            </td>
            <td><%= s.version %></td>
            <td class="right"><a class="btn btn-sm ghost" href="<%= s.url %>" target="_blank" rel="noopener">Buka dokumen</a></td>
          </tr>
        <% }) %>
        <% if (!sops.length) { %><tr><td colspan="4"><div class="empty">Belum ada SOP yang dipublikasikan.</div></td></tr><% } %>
      </tbody>
    </table>
    <div class="table-foot">
      <span>Menampilkan <%= sops.length %> dokumen SOP</span>
      <span>Dokumen dibuka sesuai izin akses pemilik tautan</span>
    </div>
  </div>
</main>

<%- include('../partials/foot') %>
