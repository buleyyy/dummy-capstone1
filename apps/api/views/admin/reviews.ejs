<%- include('../partials/head', { title }) %>
<%- include('../partials/internal-topbar', { user }) %>
<div class="app">
  <%- include('../partials/internal-sidebar', { user, active }) %>
  <div class="app-main">
    <main class="container">
      <%- include('../partials/flash', { ok, err }) %>
      <div class="pagehead">
        <div>
          <h1>Rating &amp; Ulasan</h1>
          <div class="sub">Ulasan dikirim anonim; identitas pemberi penilaian tidak disimpan atau ditampilkan.</div>
        </div>
      </div>

      <div class="table-wrap">
        <table>
          <thead><tr><th>Program</th><th>Rating</th><th>Ulasan</th><th>Tanggal</th></tr></thead>
          <tbody>
            <% reviews.forEach(function (r) { %>
              <tr>
                <td><strong><%= r.program.title %></strong></td>
                <td><span class="stars"><%= '★'.repeat(r.rating) %><%= '☆'.repeat(5 - r.rating) %></span><div class="small muted"><%= r.rating %>/5</div></td>
                <td class="small"><%= r.comment || '—' %></td>
                <td class="small muted nowrap"><%= helpers.formatDate(r.createdAt) %></td>
              </tr>
            <% }) %>
            <% if (!reviews.length) { %><tr><td colspan="4"><div class="empty">Belum ada ulasan.</div></td></tr><% } %>
          </tbody>
        </table>
      </div>
    </main>
  </div>
</div>
<%- include('../partials/foot') %>
