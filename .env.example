[TEMPLATE]
# Salin ke .env lalu isi nilai sebenarnya. Jangan commit file .env.

# --- apps/api (Express) ---
API_PORT=4000
# Origin frontend yang diizinkan (CORS, credentials)
WEB_ORIGIN=http://localhost:3000

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sopinsya
# Dipakai Prisma (dibentuk dari nilai DB_* di atas; sesuaikan jika berbeda)
DATABASE_URL="mysql://root:@localhost:3306/sopinsya"

# --- apps/web (Next.js) ---
# Dipakai oleh lib/api.js di sisi browser
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# --- Deploy Vercel (isi di dashboard Vercel, bukan di .env lokal) ---
# Database wajib remote: MySQL hosted ATAU libSQL/Turso (file: tidak persisten di Vercel).
# DATABASE_URL="mysql://user:password@host:3306/sopinsya"
# DATABASE_URL="libsql://nama-database-user.turso.io"
# TURSO_AUTH_TOKEN=
# WEB_ORIGIN=https://domain-anda.vercel.app
