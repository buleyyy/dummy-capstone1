# Salin ke .env lalu isi nilai sebenarnya. Jangan commit file .env.

# --- apps/api (Express) ---
API_PORT=4000
# Origin frontend yang diizinkan (CORS, credentials)
WEB_ORIGIN=http://localhost:3000

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sopinsya

# --- apps/web (Next.js) ---
# Dipakai oleh lib/api.js di sisi browser
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
